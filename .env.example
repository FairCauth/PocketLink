# Copy settings into your shell, or run: node --env-file=.env server/index.mjs
PORT=8787
HOST=0.0.0.0
# Trusted HTTPS certificate and key (do not commit certificates/private keys).
# TLS_CERT=certs/pocketlink.pem
# TLS_KEY=certs/pocketlink-key.pem
# Behind an HTTPS reverse proxy, configure its exact public origin.
# PUBLIC_ORIGIN=https://audio.example.com
# Allow an independently hosted frontend to use this server (exact origins).
# ALLOWED_ORIGINS=https://your-pocketlink-frontend.example.com
# TURN REST credentials: the same shared secret must be set on coturn.
# TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=replace-with-your-turn-shared-secret
# Alternatively provide your own ICE configuration; credentials are sent to clients.
# ICE_SERVERS_JSON=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"password"}]
